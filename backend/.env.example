PROJECT_NAME="Promptally API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
SITE_URL="http://localhost:3000"
DATABASE_URL="postgresql+psycopg://postgres:postgres@127.0.0.1:5434/promptally_payments_test"
SECRET_KEY="replace-with-a-random-jwt-secret"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Back up this key separately. Changing it makes stored seller credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=""

# Real socket peers only. The ingress MUST overwrite CF-IPCountry and
# CF-Connecting-IP. Run uvicorn with --no-proxy-headers.
TRUSTED_PROXY_CIDRS=[]
# Required alongside CIDRs. The ingress injects this credential; Next strips it.
TRUSTED_PROXY_TOKEN=""
# Alternative for direct public client IPs: local GeoLite2-Country.mmdb.
GEOIP_DATABASE_PATH=""

# Leave empty to use cached ECB USD/INR reference rates. An explicit value
# overrides the external feed (for development or an operator-fixed quote).
USD_TO_INR_RATE=""
FX_CACHE_SECONDS=3600

# PLATFORM account: subscriptions only. Seller keys are connected via API.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Optional. Empty creates a monthly INR plan at the current $1 equivalent.
# An explicit plan must match the current quoted amount.
RAZORPAY_PLAN_ID=""
DODO_API_KEY=""
DODO_WEBHOOK_SECRET=""
DODO_ENVIRONMENT="test"
# Configure a recurring $1 USD/month product with no discounts or trial.
DODO_PRODUCT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Independent rolling budgets per IP and per supplied device.
RATE_LIMIT_READ_PER_MINUTE=60
# Sensitive actions (writes and OAuth callbacks).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_ENABLED=true
MAX_ACCOUNTS_PER_IP=2
MAX_ACCOUNTS_PER_DEVICE=2

# Seller OAuth application (requires Razorpay Technology Partner access).
RAZORPAY_PARTNER_CLIENT_ID="TzB6hBUsnAvVVF"
RAZORPAY_PARTNER_CLIENT_SECRET="3bHIqNyfFsPycjJrFgBmoMMa"
# Configure once for order.paid and account.app.authorization_revoked on the partner application.
RAZORPAY_PARTNER_WEBHOOK_SECRET="zxcvbnm"
RAZORPAY_PARTNER_ENVIRONMENT="test"
# Empty defaults to SITE_URL + /api/v1/sellers/razorpay/oauth/callback.
RAZORPAY_PARTNER_REDIRECT_URI="https://ln54rgkc18dj.shares.zrok.io/api/v1/sellers/razorpay/oauth/callback"

# Local Docker Redis; empty disables the optimization (durable PostgreSQL guards remain).
REDIS_URL=redis://127.0.0.1:6388/0

# Verification email delivery. Use the exact SMTP host from your Zoho India account.
# Add a newly rotated app password only to backend/.env, never this example.
CELERY_BROKER_URL=redis://127.0.0.1:6388/1
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=contact@promptally.dev
SMTP_PASSWORD=""
EMAIL_FROM=contact@promptally.dev
EMAIL_TOKEN_TTL_SECONDS=900
EMAIL_RESEND_COOLDOWN_SECONDS=60

# Product analytics (PostHog)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
